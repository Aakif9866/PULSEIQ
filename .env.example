# Copy this file to .env and fill in real values for local/dev use.
# Never commit a real .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# A standard Postgres connection string — used as-is whether you're running
# natively or via docker-compose (there's no separate local Postgres
# container to keep in sync; point this at whatever Postgres you're using,
# e.g. a Neon/Supabase/RDS instance, or your own local Postgres).
# A bare "postgresql://" or "postgres://" scheme is rewritten to
# "postgresql+psycopg://" automatically — paste your provider's URL as-is.
DATABASE_URL=postgresql://pulseiq:pulseiq@localhost:5432/pulseiq

# --- Storage ---
# "local" stores uploads on the backend's own filesystem — fully functional
# on its own, no Cloudflare account needed. Persistence across restarts
# depends on the hosting platform (a mounted volume vs. ephemeral disk) —
# see STORAGE.md. "r2" stores uploads in Cloudflare R2 (S3-compatible) —
# requires every R2_* value below; the app refuses to start with a clear
# error if STORAGE_PROVIDER=r2 and any of them are missing. See STORAGE.md
# for the exact migration steps from local to R2.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./data/uploads

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

MAX_UPLOAD_SIZE_MB=200

# Reserved for a future scheduled cleanup job — not implemented yet (needs
# background workers, deferred in PHASES.md Phase 6). Safe to leave as-is.
ENABLE_STORAGE_CLEANUP=false
DATASET_RETENTION_DAYS=7

# --- AI (Groq) ---
# "none" disables AI features gracefully; set to "groq" once GROQ_API_KEY is set.
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional — USD per 1,000,000 tokens, from Groq's own current pricing
# for GROQ_MODEL above (console.groq.com/settings/billing). Both unset
# by default: cost is then honestly reported as unavailable rather than
# computed from a guessed/stale number. Tokens and latency are always
# logged regardless of these.
# GROQ_INPUT_COST_PER_1M_TOKENS=
# GROQ_OUTPUT_COST_PER_1M_TOKENS=
# Optional — per-user AI token budget per UTC day. Unset = no limit
# (usage is still recorded and shown on the Usage page). When set, a
# user over the limit gets a 429 with the reset time; cached answers
# are still served since they cost nothing.
# AI_DAILY_TOKEN_QUOTA_PER_USER=50000

# --- Optional tracing (OpenTelemetry / OTLP over HTTP) ---
# Unset = tracing fully off (no-op, nothing exported). Set to an OTLP/HTTP
# base URL (the exporter appends /v1/traces) — e.g. a local Jaeger or
# Grafana Tempo on :4318, or a hosted backend. Every request becomes one
# trace: HTTP -> analyze -> each LLM call and each tool call, tagged with
# the same request_id as the logs. Headers, e.g. an API key, go in
# OTEL_EXPORTER_OTLP_HEADERS as "key=value,key2=value2" (never logged).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=pulseiq-backend

# --- Email alerting (V2: anomaly monitoring, feature/pulseiq-v2-roadmap) ---
# Sent via stdlib smtplib — no extra dependency. Leaving SMTP_HOST unset
# disables email alerting gracefully: an anomaly is still detected and
# persisted, only the email step is skipped (recorded on the anomaly, not
# treated as a failure). See docs/V2_ROADMAP.md's "AI Anomaly Monitoring"
# section.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
