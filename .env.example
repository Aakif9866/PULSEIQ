# Copy this file to .env and fill in real values for local/dev use.
# Never commit a real .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# A standard Postgres connection string — used as-is whether you're running
# natively or via docker-compose (there's no separate local Postgres
# container to keep in sync; point this at whatever Postgres you're using,
# e.g. a Neon/Supabase/RDS instance, or your own local Postgres).
# A bare "postgresql://" or "postgres://" scheme is rewritten to
# "postgresql+psycopg://" automatically — paste your provider's URL as-is.
DATABASE_URL=postgresql://pulseiq:pulseiq@localhost:5432/pulseiq

# --- Storage ---
# "local" stores uploads on the backend's own filesystem — fully functional
# on its own, no Cloudflare account needed. Persistence across restarts
# depends on the hosting platform (a mounted volume vs. ephemeral disk) —
# see STORAGE.md. "r2" stores uploads in Cloudflare R2 (S3-compatible) —
# requires every R2_* value below; the app refuses to start with a clear
# error if STORAGE_PROVIDER=r2 and any of them are missing. See STORAGE.md
# for the exact migration steps from local to R2.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./data/uploads

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

MAX_UPLOAD_SIZE_MB=200

# Reserved for a future scheduled cleanup job — not implemented yet (needs
# background workers, deferred in PHASES.md Phase 6). Safe to leave as-is.
ENABLE_STORAGE_CLEANUP=false
DATASET_RETENTION_DAYS=7

# --- AI (Groq) ---
# "none" disables AI features gracefully; set to "groq" once GROQ_API_KEY is set.
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
